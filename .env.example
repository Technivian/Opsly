# Aurivian / Opsly Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/opscopilot

# Session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OpenAI (for blueprint generation)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Gmail OAuth (optional - for email automation)
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:5000/api/connections/gmail/callback

# Base URL (for OAuth redirects)
BASE_URL=http://localhost:5000

# Node Environment
NODE_ENV=development
