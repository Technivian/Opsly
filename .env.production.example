# Opsly Production Environment Template
# Copy this to .env and fill in real values

# =====================================
# CORE CONFIGURATION
# =====================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =====================================
# DATABASE (PostgreSQL)
# =====================================
# Format: postgresql://username:password@host:port/database
# Example production: postgresql://opsly_user:secure_pass@db.example.com:5432/opsly_prod
DATABASE_URL=postgresql://user:password@localhost:5432/opsly_prod

# =====================================
# SECURITY & SESSIONS
# =====================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# =====================================
# AI INTEGRATION (OpenAI)
# =====================================
# Required for blueprint generation
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# =====================================
# OPTIONAL: MONITORING & LOGGING
# =====================================
# Sentry for error tracking (recommended)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# =====================================
# OPTIONAL: OAUTH (For Real Integrations)
# =====================================
# Only needed if implementing real Gmail/Outlook integrations
# Leave blank for demo mode

# Gmail OAuth (if implementing)
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REDIRECT_URI=https://your-domain.com/api/connections/gmail/callback

# Base URL for OAuth redirects
# BASE_URL=https://your-production-domain.com

# =====================================
# PRODUCTION DEPLOYMENT INFO
# =====================================
# Not used by app, but helpful for deployment tracking
# DEPLOYED_AT=2026-02-03
# DEPLOYED_BY=your-name
# GIT_COMMIT=abc123def
