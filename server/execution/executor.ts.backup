          exceptions: 1,
        },
      });
    }
  }
}

/**
 * Log a message to the run logs
 */
export async function log(
  runId: number, 
  level: "INFO" | "WARN" | "ERROR", 
  message: string,
  meta?: Record<string, unknown>
): Promise<void> {
  await storage.createRunLog({
    runId,
    level,
    message,
    metaJson: meta,
  });
}

